{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on friday"]
  },
  "customManagers": [
    {
      "description": "Pinned stable toolchain in workflow env (marked with a `# renovate:` comment)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+: \"?(?<currentValue>[^\"\\n]+)\"?"
      ]
    }
  ]
}
